{
  "name": "wappacvelyze-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser extension: technologies behind a site, their versions, and known CVEs",
  "scripts": {
    "data": "go run ../cmd/gen-extension-data src/generated && node scripts/fetch-icons.mjs",
    "build": "npm run data && node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "fmt": "oxfmt src test build.mjs scripts",
    "lint:firefox": "npx --yes web-ext@10.6.0 lint --source-dir dist-firefox",
    "run:firefox": "npx --yes web-ext@10.6.0 run --source-dir dist-firefox",
    "package:chrome": "cd dist && zip -qr ../../dist-artifacts/wappacvelyze-chrome-$npm_package_version.zip . -x '.DS_Store'",
    "package:firefox": "npx --yes web-ext@10.6.0 build --source-dir dist-firefox --artifacts-dir ../dist-artifacts --overwrite-dest"
  },
  "devDependencies": {
    "@types/chrome": "0.2.9",
    "esbuild": "0.28.2",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
